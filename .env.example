# Copiar a .env.local y completar. En Vercel, cargar estas mismas variables
# en Settings → Environment Variables. Nunca subir valores reales al repo.

# Google Sheets (etapa 2) — cuenta de servicio con acceso de editor al Sheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada en una sola línea, con los saltos como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Candado de concurrencia (etapa 3) — Upstash Redis, plan gratuito
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Login (etapa 5) — generar con: npx auth secret
AUTH_SECRET=
