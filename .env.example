# Copiar a .env.local y completar. En Vercel, cargar estas mismas variables
# en Settings → Environment Variables. Nunca subir valores reales al repo.

# Google Sheets (etapa 2) — cuenta de servicio con acceso de editor al Sheet
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada en una sola línea, con los saltos como \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firma de la sesión (login). Mínimo 32 caracteres al azar, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si cambia, todos los usuarios tienen que volver a ingresar.
AUTH_SECRET=
